# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# These belong on a BACKEND server, not the front end.
# The generation backend (server/index.mjs, run with `npm run server`) reads:
ANTHROPIC_API_KEY=your_anthropic_key_here   # lore generation (Claude)
GOOGLE_API_KEY=your_google_gemini_key_here  # face -> character art (nano-banana)
# Optional backend config:
# PORT=8787
# ALLOW_ORIGIN=http://localhost:5173   # comma-separated allowlist, or *
# SIDEQUEST_API_TOKEN=                  # if set, paid endpoints require this bearer token
# RATE_MAX=30                           # max paid requests per IP per window
# RATE_WINDOW_MS=60000
# MAX_GENERATIONS_PER_DAY=500           # hard daily ceiling (bounds worst-case spend)
# UPSTREAM_TIMEOUT_MS=60000             # text calls (Anthropic, Stripe)
# IMAGE_TIMEOUT_MS=120000               # art calls — slower and more variable than text

# Card art encoding. Art is stored inline in the deck payload, so these control
# how big a saved deck is. Resolution is never reduced (printed cards need it).
# ART_ASPECT=3:4                        # cards are portrait; landscape gets cropped
# ART_FORMAT=jpeg                       # jpeg (mozjpeg) | webp | off to disable
# ART_QUALITY=82                        # ~5x smaller than Gemini's raw output

# Marketplace take rate, in basis points (1200 = 12%). Charged to the creator
# only — the buyer pays the listed price with nothing added at checkout.
# PLATFORM_FEE_BPS=1200

# Checkout (Stripe) — enables /api/checkout + /api/webhooks/stripe:
STRIPE_SECRET_KEY=your_stripe_secret_here          # sk_test_... (use TEST keys first)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret   # whsec_... from the webhook you create
# SITE_URL=https://wigilf.github.io/Side-Quest/     # where Stripe returns after payment
# DECK_PRICE_CENTS=3900                              # $39 per deck (server-computed price)
# SHIPPING_CENTS=700

# Still to be wired (fulfillment — see docs/SideQuest_Checkout_Flow.md §D):
PRODIGI_API_KEY=your_print_provider_key_here

# ---------------------------------------------------------------------------
# FRONTEND (Vite) — safe to expose; points the app at the backend above.
# Without this, the app runs in offline demo mode (themed fallback decks,
# procedural art). Set it to enable live AI lore + face->character art.
# ---------------------------------------------------------------------------
# VITE_API_BASE=http://localhost:8787
# VITE_API_TOKEN=            # only if the backend sets SIDEQUEST_API_TOKEN

# Object storage (Cloudflare R2) — art and uploads are served from here instead
# of being inlined as base64 in the deck payload. Without these the server still
# works; decks are just large again.
# R2_ACCOUNT_ID=                        # 32-hex, from the R2 overview page
# R2_BUCKET=sidequest-art
# R2_ACCESS_KEY_ID=                     # S3 Access Key ID from an R2 API token
# R2_SECRET_ACCESS_KEY=                 # shown once at token creation
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev # the PUBLIC bucket URL — NOT the
#                                       # *.r2.cloudflarestorage.com API endpoint,
#                                       # which 401s a browser <img> request
# R2_ENDPOINT=                          # override for S3-compatible testing (MinIO)
