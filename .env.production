# Production build settings. Vite loads .env.production for `vite build` and it
# takes precedence over .env, so `npm run build` produces a deployable bundle by
# default — .env stays free to point at localhost for `npm run dev`.
#
# Committed on purpose: this is a public URL, not a secret. Never put keys here,
# because anything VITE_-prefixed is compiled into the browser bundle.
VITE_API_BASE=https://sidequest-backend-bpoa.onrender.com
